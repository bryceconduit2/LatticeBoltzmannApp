<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.bc.fluidsandbox.WindTunnelView
        android:id="@+id/windTunnelView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="12dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnGraph"
            style="?attr/materialButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginEnd="6dp"
            android:padding="0dp"
            android:text="@string/btn_graph"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnSettings"
            style="?attr/materialButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginEnd="6dp"
            android:padding="0dp"
            android:text="@string/btn_settings"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnReset"
            style="?attr/materialButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:padding="0dp"
            android:text="@string/btn_reset"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Graph Overlay Container -->
    <FrameLayout
        android:id="@+id/graphContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#E0000000"
        android:visibility="gone">

        <com.bc.fluidsandbox.ForceGraphView
            android:id="@+id/forceGraphView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="40dp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical|end"
            android:layout_margin="16dp"
            android:background="#A0000000"
            android:orientation="vertical"
            android:padding="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_plot_mode"
                android:textColor="@android:color/white"
                android:textSize="12sp"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/rgGraphMode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/rbModeForce"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:checked="true"
                    android:text="@string/rb_mode_force"
                    android:textColor="@android:color/white"
                    android:textSize="10sp" />

                <RadioButton
                    android:id="@+id/rbModeCoef"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:text="@string/rb_mode_coef"
                    android:textColor="@android:color/white"
                    android:textSize="10sp" />
            </RadioGroup>
        </LinearLayout>

        <Button
            android:id="@+id/btnCloseGraph"
            style="?attr/materialButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_gravity="top|end"
            android:layout_margin="16dp"
            android:padding="0dp"
            android:text="@string/btn_close"
            android:textSize="12sp" />
    </FrameLayout>

</FrameLayout>
