<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:scrollbars="vertical"
    android:fadeScrollbars="false"
    android:scrollbarSize="12dp"
    android:scrollbarThumbVertical="@android:color/darker_gray"
    android:scrollbarStyle="insideOverlay">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#E0000000"
        android:orientation="vertical"
        android:paddingTop="24dp"
        android:paddingBottom="24dp"
        android:paddingStart="24dp"
        android:paddingEnd="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tunnel Size"
            android:textColor="@android:color/white"
            android:textSize="18sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/rgSize"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/rbTiny"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tiny (160x80 - Performance)"
                android:textColor="@android:color/white" />

            <RadioButton
                android:id="@+id/rbSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Small (0.5m x 0.25m)"
                android:textColor="@android:color/white" />

            <RadioButton
                android:id="@+id/rbMedium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="Medium (1.0m x 0.5m)"
                android:textColor="@android:color/white" />

            <RadioButton
                android:id="@+id/rbLarge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Large (1.5m x 0.75m)"
                android:textColor="@android:color/white" />
        </RadioGroup>

        <Space
            android:layout_width="match_parent"
            android:layout_height="16dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Airflow Speed"
                android:textColor="@android:color/white" />

            <TextView
                android:id="@+id/tvSpeedValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="30.0 m/s"
                android:textColor="@android:color/white" />
        </LinearLayout>

        <SeekBar
            android:id="@+id/sbSpeed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="200"
            android:progress="120" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="16dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Physics Precision (Time Step)"
                android:textColor="@android:color/white"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDtValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Precise (1.0x)"
                android:textColor="@android:color/white" />
        </LinearLayout>

        <SeekBar
            android:id="@+id/sbDtScale"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="40"
            android:progress="0" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Brush Shape"
            android:textColor="@android:color/white"
            android:textSize="18sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/rgShape"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/rbCircle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="Circle Brush"
                android:textColor="@android:color/white" />

            <RadioButton
                android:id="@+id/rbSquare"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Square Brush"
                android:textColor="@android:color/white" />

            <RadioButton
                android:id="@+id/rbNaca"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Wing / NACA Airfoil"
                android:textColor="@android:color/white" />
        </RadioGroup>

        <LinearLayout
            android:id="@+id/llNacaSelector"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Select Profile"
                android:textColor="#A0FFFFFF"
                android:textSize="12sp" />

            <Spinner
                android:id="@+id/spNacaProfiles"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:popupBackground="#202020"
                android:backgroundTint="@android:color/white" />
        </LinearLayout>

        <Space
            android:layout_width="match_parent"
            android:layout_height="16dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Angle of Attack (Wings)"
                android:textColor="@android:color/white" />

            <TextView
                android:id="@+id/tvAoAValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0°"
                android:textColor="@android:color/white" />
        </LinearLayout>

        <SeekBar
            android:id="@+id/sbAoA"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="40"
            android:progress="20" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="16dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Brush Size / Chord"
                android:textColor="@android:color/white" />

            <TextView
                android:id="@+id/tvBrushSizeValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="8 px"
                android:textColor="@android:color/white" />
        </LinearLayout>

        <SeekBar
            android:id="@+id/sbBrushSize"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="40"
            android:progress="8" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Visualization Map"
            android:textColor="@android:color/white"
            android:textSize="18sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/rgViz"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/rbVizVelocity"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="Velocity"
                android:textColor="@android:color/white" />

            <RadioButton
                android:id="@+id/rbVizPressure"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Static Pressure"
                android:textColor="@android:color/white" />

            <RadioButton
                android:id="@+id/rbVizTotal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Total Pressure"
                android:textColor="@android:color/white" />
        </RadioGroup>

        <Space
            android:layout_width="match_parent"
            android:layout_height="8dp" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/swAbsolute"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Absolute Pressure"
            android:textColor="@android:color/white" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Boundary Conditions"
            android:textColor="@android:color/white"
            android:textSize="18sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/rgBoundary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/rbBndPeriodic"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="Periodic"
                android:textColor="@android:color/white" />

            <RadioButton
                android:id="@+id/rbBndNoSlip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Solid Walls"
                android:textColor="@android:color/white" />

            <RadioButton
                android:id="@+id/rbBndFreeSlip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Symmetry/Smooth"
                android:textColor="@android:color/white" />
        </RadioGroup>

        <Space
            android:layout_width="match_parent"
            android:layout_height="16dp" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/swTelemetry"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="Show Detailed Stats"
            android:textColor="@android:color/white" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/swGridlines"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Show Gridlines"
            android:textColor="@android:color/white" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="16dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Processing Cores"
                android:textColor="@android:color/white"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvCoreValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="4"
                android:textColor="@android:color/white" />
        </LinearLayout>

        <SeekBar
            android:id="@+id/sbCores"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="8"
            android:progress="4" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="8dp" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="32dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Educational Disclaimer:\nThis app is to be used as an educational tool only and not be relied upon for any design calculations. Please allow the flow to stabilise before reading any results, turbulence can cause significant fluctuations. Uses Lattice Boltzmann with Bouzidi–Firdaouss–Lallemand (BFL) scheme for boundary collisions"
            android:textColor="#A0FFFFFF"
            android:textSize="12sp"
            android:textStyle="italic"
            android:gravity="center" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
