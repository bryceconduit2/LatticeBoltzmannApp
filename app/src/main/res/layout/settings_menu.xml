<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:scrollbars="vertical"
    android:fadeScrollbars="false"
    android:scrollbarSize="12dp"
    android:scrollbarThumbVertical="@android:color/darker_gray"
    android:scrollbarStyle="insideOverlay">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#E0000000"
        android:orientation="vertical"
        android:paddingTop="24dp"
        android:paddingBottom="24dp"
        android:paddingStart="24dp"
        android:paddingEnd="32dp">

        <Button
            android:id="@+id/btnResetDefaults"
            style="?attr/materialButtonStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="@string/btn_reset_defaults"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/header_tunnel_size"
                android:textColor="@android:color/white"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvResolutionValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="400x200"
                android:textColor="@android:color/white"
                android:textStyle="bold" />
        </LinearLayout>

        <SeekBar
            android:id="@+id/sbResolution"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="840"
            android:progress="240" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="16dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/label_airflow_speed"
                android:textColor="@android:color/white" />

            <TextView
                android:id="@+id/tvSpeedValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="30.0 m/s"
                android:textColor="@android:color/white" />
        </LinearLayout>

        <SeekBar
            android:id="@+id/sbSpeed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="200"
            android:progress="120" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="16dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/label_simulation_scale"
                android:textColor="@android:color/white" />

            <TextView
                android:id="@+id/tvDXValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2.5mm"
                android:textColor="@android:color/white" />
        </LinearLayout>

        <SeekBar
            android:id="@+id/sbDX"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="195"
            android:progress="20" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="16dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/label_fluid_density"
                android:textColor="@android:color/white" />

            <TextView
                android:id="@+id/tvDensityValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1.22 kg/m³"
                android:textColor="@android:color/white" />
        </LinearLayout>

        <SeekBar
            android:id="@+id/sbDensity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="200"
            android:progress="122" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="16dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/label_fluid_viscosity"
                android:textColor="@android:color/white" />

            <TextView
                android:id="@+id/tvViscosityValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1.5e-5 m²/s"
                android:textColor="@android:color/white" />
        </LinearLayout>

        <SeekBar
            android:id="@+id/sbViscosity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"
            android:progress="15" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="16dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/label_physics_precision"
                android:textColor="@android:color/white"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDtValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Precise (1.0x)"
                android:textColor="@android:color/white" />
        </LinearLayout>

        <SeekBar
            android:id="@+id/sbDtScale"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="40"
            android:progress="0" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/header_brush_shape"
            android:textColor="@android:color/white"
            android:textSize="18sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/rgShape"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/rbCircle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/rb_circle"
                android:textColor="@android:color/white" />

            <RadioButton
                android:id="@+id/rbSquare"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/rb_square"
                android:textColor="@android:color/white" />

            <RadioButton
                android:id="@+id/rbNaca"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/rb_naca"
                android:textColor="@android:color/white" />
        </RadioGroup>

        <LinearLayout
            android:id="@+id/llNacaSelector"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_select_profile"
                android:textColor="#A0FFFFFF"
                android:textSize="12sp" />

            <Spinner
                android:id="@+id/spNacaProfiles"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:popupBackground="#202020"
                android:backgroundTint="@android:color/white" />
        </LinearLayout>

        <Space
            android:layout_width="match_parent"
            android:layout_height="16dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/label_aoa"
                android:textColor="@android:color/white" />

            <TextView
                android:id="@+id/tvAoAValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0°"
                android:textColor="@android:color/white" />
        </LinearLayout>

        <SeekBar
            android:id="@+id/sbAoA"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="40"
            android:progress="20" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="16dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/label_brush_size"
                android:textColor="@android:color/white" />

            <TextView
                android:id="@+id/tvBrushSizeValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="8 px"
                android:textColor="@android:color/white" />
        </LinearLayout>

        <SeekBar
            android:id="@+id/sbBrushSize"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="80"
            android:progress="8" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/header_visualization"
            android:textColor="@android:color/white"
            android:textSize="18sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/rgViz"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/rbVizVelocity"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:checked="true"
                android:text="@string/rb_viz_velocity"
                android:textColor="@android:color/white" />

            <RadioButton
                android:id="@+id/rbVizPressure"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/rb_viz_pressure"
                android:textColor="@android:color/white" />

            <RadioButton
                android:id="@+id/rbVizTotal"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/rb_viz_total"
                android:textColor="@android:color/white" />
        </RadioGroup>

        <Space
            android:layout_width="match_parent"
            android:layout_height="8dp" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/swAbsolute"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/sw_absolute_pressure"
            android:textColor="@android:color/white" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/header_color_scheme"
            android:textColor="@android:color/white"
            android:textSize="18sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/rgColorScheme"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/rbColorStandard"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/rb_color_standard"
                android:textColor="@android:color/white" />

            <RadioButton
                android:id="@+id/rbColorIronbow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/rb_color_ironbow"
                android:textColor="@android:color/white" />

            <RadioButton
                android:id="@+id/rbColorGrayscale"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/rb_color_grayscale"
                android:textColor="@android:color/white" />

            <RadioButton
                android:id="@+id/rbColorOcean"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/rb_color_ocean"
                android:textColor="@android:color/white" />
        </RadioGroup>

        <Space
            android:layout_width="match_parent"
            android:layout_height="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/header_boundaries"
            android:textColor="@android:color/white"
            android:textSize="18sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/rgBoundary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/rbBndPeriodic"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/rb_bnd_periodic"
                android:textColor="@android:color/white" />

            <RadioButton
                android:id="@+id/rbBndOpen"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/rb_bnd_open"
                android:textColor="@android:color/white" />
        </RadioGroup>

        <Space
            android:layout_width="match_parent"
            android:layout_height="16dp" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/swTelemetry"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="@string/sw_telemetry"
            android:textColor="@android:color/white" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/swSmoothHD"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="false"
            android:text="Smooth HD Graphics (experimental)"
            android:textColor="@android:color/white" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/swGridlines"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/sw_gridlines"
            android:textColor="@android:color/white" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="16dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/label_processing_cores"
                android:textColor="@android:color/white"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvCoreValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="4"
                android:textColor="@android:color/white" />
        </LinearLayout>

        <SeekBar
            android:id="@+id/sbCores"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="8"
            android:progress="4" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="8dp" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="32dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/disclaimer_text"
            android:textColor="#A0FFFFFF"
            android:textSize="12sp"
            android:textStyle="italic"
            android:gravity="center" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
